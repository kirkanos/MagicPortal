[Unit]
Description=%SERVICE%
After=docker.service
BindsTo=docker.service
StartLimitIntervalSec=0

[Service]
Restart=always
# Do not restart every second: without a pause systemd gives up after 5 tries
# within a few seconds (start-limit), so even a brief registry hiccup would
# take the service down for good.
RestartSec=15
WorkingDirectory=/services/%SERVICE%/
ExecStart=/usr/bin/docker compose up --build --force-recreate --pull always
ExecStop=/usr/bin/docker compose down

[Install]
WantedBy=multi-user.target
