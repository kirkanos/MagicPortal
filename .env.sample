# Template:  cp .env.sample .env
#
# Everything except UPLOAD_PASSWORD is optional. The first three values are
# only needed when running behind Traefik (docker-compose.yml); the standalone
# stack (docker-compose.standalone.yml) runs with no .env at all.

# --- docker-compose.yml only (Traefik) ---
SERVICE=magic-portal
HOST=mtg.example.com
# Internal port of the web container that Traefik routes to.
PORT=80

# --- docker-compose.standalone.yml only ---
# Published port and the address it binds to.
#HTTP_PORT=8080
#BIND=127.0.0.1

# Password for upload/reset/sync (empty = no protection).
UPLOAD_PASSWORD=changeme

# Optional: analytics. Without ANALYTICS_SCRIPT_URL and ANALYTICS_EVENT_URL
# nothing happens at all - the pages load no third-party code and nginx
# proxies nothing. Both URLs point at your own analytics instance; the script
# is then served from /js/pl.js on your own domain, so content blockers do not
# filter it out.
#
# Umami:
#ANALYTICS_SCRIPT_URL=https://stats.example.com/script.js
#ANALYTICS_EVENT_URL=https://stats.example.com/api/send
#ANALYTICS_WEBSITE_ID=00000000-0000-0000-0000-000000000000
#
# Plausible (different attribute, different event path):
#ANALYTICS_SCRIPT_URL=https://plausible.example.com/js/script.js
#ANALYTICS_EVENT_URL=https://plausible.example.com/api/event
#ANALYTICS_WEBSITE_ID=mtg.example.com
#ANALYTICS_ID_ATTRIBUTE=data-domain
#ANALYTICS_EVENT_PATH=/api/event

# Optional: background sync interval (minutes, default 5)
#SYNC_INTERVAL_MINUTES=5

# Optional: automatic remote import of a ManaBox export (empty = off)
#REMOTE_IMPORT_INTERVAL_MINUTES=15
# Delete the source file after a successful import (default true; false = keep)
#REMOTE_IMPORT_DELETE=true
# -- Nextcloud / WebDAV --
#WEBDAV_URL=https://cloud.example.com/remote.php/dav/files/USER/manabox/export.csv
#WEBDAV_USER=myuser
#WEBDAV_PASSWORD=app-password
# -- Google Drive (service account) --
#GDRIVE_FILE_ID=1AbCdEfGhIjKlMnOpQrStUvWxYz
#GDRIVE_SA_JSON=/run/secrets/gdrive-sa.json

# Optional: local mirror of the card images and symbols. Needs disk space
# (~1.6 GB at 14,000 printings) and runs once a day at night. Off = the
# interface fetches the images directly from Scryfall as before.
#IMAGE_MIRROR=true
#IMAGE_SYNC_HOUR=3
#IMAGE_SIZES=small,normal
#IMAGE_RATE_PER_SECOND=10
#IMAGE_MAX_BYTES=3221225472

# Optional: image hash index for the Android scanner, which recognises old
# and foreign cards by their artwork. Fetches the small scans of all
# old-frame and owned printings once (~350 MB), afterwards only changes.
#HASH_INDEX=true
#HASH_SCOPE=old
#HASH_SYNC_HOUR=4
#HASH_RATE_PER_SECOND=8

# Optional: Prometheus metrics on a separate port (not via nginx/Traefik).
# METRICS_PORT=off disables the endpoint. See docs/monitoring.md
#METRICS_PORT=9090
#METRICS_CACHE_SECONDS=30

# Optional: automatic backup of your own data (collection + value history)
#BACKUP_INTERVAL_HOURS=24
#BACKUP_KEEP=30
# -- Nextcloud / WebDAV (target folder, same credentials as for the import) --
#WEBDAV_BACKUP_DIR=https://cloud.example.com/remote.php/dav/files/USER/mtg-backups/
# -- Google Drive (target folder ID, same service account as for the import) --
#GDRIVE_BACKUP_FOLDER_ID=1XyZaBcDeFgHiJkLmNoPqRsTuVwXyZ
