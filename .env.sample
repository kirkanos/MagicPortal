SERVICE=magic-portal
HOST=mtg.kirkanos.net
PORT=80
UPLOAD_PASSWORD=changeme

# Optional: Hintergrund-Sync-Intervall (Minuten, Standard 5)
#SYNC_INTERVAL_MINUTES=5

# Optional: automatischer Remote-Import eines ManaBox-Exports (leer = aus)
#REMOTE_IMPORT_INTERVAL_MINUTES=15
# -- Nextcloud / WebDAV --
#WEBDAV_URL=https://cloud.example.com/remote.php/dav/files/USER/manabox/export.csv
#WEBDAV_USER=meinuser
#WEBDAV_PASSWORD=app-passwort
# -- Google Drive (Service-Account) --
#GDRIVE_FILE_ID=1AbCdEfGhIjKlMnOpQrStUvWxYz
#GDRIVE_SA_JSON=/run/secrets/gdrive-sa.json

# Optional: automatisches Backup der eigenen Daten (Sammlung + Wert-Historie)
#BACKUP_INTERVAL_HOURS=24
#BACKUP_KEEP=30
# -- Nextcloud / WebDAV (Ziel-Ordner, gleiche Zugangsdaten wie beim Import) --
#WEBDAV_BACKUP_DIR=https://cloud.example.com/remote.php/dav/files/USER/mtg-backups/
# -- Google Drive (Ziel-Ordner-ID, gleiches Service-Account wie beim Import) --
#GDRIVE_BACKUP_FOLDER_ID=1XyZaBcDeFgHiJkLmNoPqRsTuVwXyZ
