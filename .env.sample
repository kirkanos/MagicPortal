# Vorlage:  cp .env.sample .env
#
# Alles ausser UPLOAD_PASSWORD ist optional. Die drei ersten Werte braucht nur
# der Betrieb hinter Traefik (docker-compose.yml); der Standalone-Stack
# (docker-compose.standalone.yml) laeuft auch ganz ohne .env.

# --- nur docker-compose.yml (Traefik) ---
SERVICE=magic-portal
HOST=mtg.example.com
# Interner Port des web-Containers, auf den Traefik routet.
PORT=80

# --- nur docker-compose.standalone.yml ---
# Veroeffentlichter Port und die Adresse, auf der er liegt.
#HTTP_PORT=8080
#BIND=127.0.0.1

# Passwort fuer Upload/Reset/Sync (leer = kein Schutz).
UPLOAD_PASSWORD=changeme

# Optional: Reichweitenmessung. Ohne ANALYTICS_SCRIPT_URL und
# ANALYTICS_EVENT_URL passiert gar nichts - die Seiten laden keine Zeile
# fremden Code und nginx proxyt nichts. Beide URLs zeigen auf die eigene
# Analytics-Instanz; ausgeliefert wird das Skript dann unter /js/pl.js der
# eigenen Domain, damit Inhaltsblocker es nicht wegfiltern.
#
# Umami:
#ANALYTICS_SCRIPT_URL=https://stats.example.com/script.js
#ANALYTICS_EVENT_URL=https://stats.example.com/api/send
#ANALYTICS_WEBSITE_ID=00000000-0000-0000-0000-000000000000
#
# Plausible (anderes Attribut, anderer Ereignis-Pfad):
#ANALYTICS_SCRIPT_URL=https://plausible.example.com/js/script.js
#ANALYTICS_EVENT_URL=https://plausible.example.com/api/event
#ANALYTICS_WEBSITE_ID=mtg.example.com
#ANALYTICS_ID_ATTRIBUTE=data-domain
#ANALYTICS_EVENT_PATH=/api/event

# Optional: Hintergrund-Sync-Intervall (Minuten, Standard 5)
#SYNC_INTERVAL_MINUTES=5

# Optional: automatischer Remote-Import eines ManaBox-Exports (leer = aus)
#REMOTE_IMPORT_INTERVAL_MINUTES=15
# Quelldatei nach erfolgreichem Import löschen (Standard true; false = behalten)
#REMOTE_IMPORT_DELETE=true
# -- Nextcloud / WebDAV --
#WEBDAV_URL=https://cloud.example.com/remote.php/dav/files/USER/manabox/export.csv
#WEBDAV_USER=meinuser
#WEBDAV_PASSWORD=app-passwort
# -- Google Drive (Service-Account) --
#GDRIVE_FILE_ID=1AbCdEfGhIjKlMnOpQrStUvWxYz
#GDRIVE_SA_JSON=/run/secrets/gdrive-sa.json

# Optional: lokaler Spiegel der Kartenbilder und Symbole. Braucht Platz
# (~1,6 GB bei 14.000 Drucken) und laeuft einmal taeglich nachts. Aus = die
# Oberflaeche holt die Bilder wie bisher direkt von Scryfall.
#IMAGE_MIRROR=true
#IMAGE_SYNC_HOUR=3
#IMAGE_SIZES=small,normal
#IMAGE_RATE_PER_SECOND=10
#IMAGE_MAX_BYTES=3221225472

# Optional: Prometheus-Metriken auf eigenem Port (nicht via nginx/Traefik).
# METRICS_PORT=off schaltet den Endpunkt ab. Siehe docs/monitoring.md
#METRICS_PORT=9090
#METRICS_CACHE_SECONDS=30

# Optional: automatisches Backup der eigenen Daten (Sammlung + Wert-Historie)
#BACKUP_INTERVAL_HOURS=24
#BACKUP_KEEP=30
# -- Nextcloud / WebDAV (Ziel-Ordner, gleiche Zugangsdaten wie beim Import) --
#WEBDAV_BACKUP_DIR=https://cloud.example.com/remote.php/dav/files/USER/mtg-backups/
# -- Google Drive (Ziel-Ordner-ID, gleiches Service-Account wie beim Import) --
#GDRIVE_BACKUP_FOLDER_ID=1XyZaBcDeFgHiJkLmNoPqRsTuVwXyZ
