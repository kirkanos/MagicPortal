server {
    listen       80;
    server_name  _;
    root   /usr/share/nginx/html;
    index  index.html;

    # Collection/card JSON payloads run into several MB uncompressed for large
    # collections; gzip cuts that drastically for both the API and static assets.
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_comp_level 5;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;

    # --- Local image mirror with a fallback to Scryfall ---
    # The volume sits at <root>/img. try_files decides per file: if it is
    # mirrored it comes from here, otherwise nginx fetches it from Scryfall.
    # That is why the browser needs no existence check per card - that would
    # be an extra request per image and cost more than the mirror saves.
    #
    # With the mirror off (IMAGE_MIRROR), the frontend builds Scryfall URLs
    # directly and these blocks are never requested.
    location /img/cards/ {
        try_files $uri @scryfall_cards;
        add_header Cache-Control "public, max-age=2592000" always;
    }
    location @scryfall_cards {
        rewrite ^/img/cards/(.*)$ /$1 break;
        proxy_pass https://cards.scryfall.io;
        proxy_set_header Host cards.scryfall.io;
        proxy_ssl_server_name on;
        # Do not forward visitor headers to a third-party CDN: an SSO cookie
        # for our own domain rides along on this request too and has no
        # business at Scryfall - and their CDN even aborts requests carrying a
        # large cookie (which shows up as a 414 instead of an image).
        proxy_set_header Cookie "";
        proxy_set_header Authorization "";
    }

    location /img/sets/ {
        try_files $uri @scryfall_svg;
        expires 30d;
    }
    location /img/symbols/ {
        try_files $uri @scryfall_symbols;
        expires 30d;
    }
    location @scryfall_svg {
        rewrite ^/img/sets/(.*)$ /sets/$1 break;
        proxy_pass https://svgs.scryfall.io;
        proxy_set_header Host svgs.scryfall.io;
        proxy_ssl_server_name on;
        # Do not forward visitor headers to a third-party CDN: an SSO cookie
        # for our own domain rides along on this request too and has no
        # business at Scryfall - and their CDN even aborts requests carrying a
        # large cookie (which shows up as a 414 instead of an image).
        proxy_set_header Cookie "";
        proxy_set_header Authorization "";
    }
    location @scryfall_symbols {
        rewrite ^/img/symbols/(.*)$ /card-symbols/$1 break;
        proxy_pass https://svgs.scryfall.io;
        proxy_set_header Host svgs.scryfall.io;
        proxy_ssl_server_name on;
        # Do not forward visitor headers to a third-party CDN: an SSO cookie
        # for our own domain rides along on this request too and has no
        # business at Scryfall - and their CDN even aborts requests carrying a
        # large cookie (which shows up as a 414 instead of an image).
        proxy_set_header Cookie "";
        proxy_set_header Authorization "";
    }

    # --- Analytics (optional) ---
    # The two proxy paths are generated at startup from the ANALYTICS_*
    # variables by /docker-entrypoint.d/30-analytics.sh. With nothing set the
    # file is empty and nothing is proxied (see nginx/analytics.sh and the
    # README).
    include /etc/nginx/conf.d/analytics/locations.conf;

    # API requests are proxied to the Go backend container.
    location /api/ {
        proxy_pass http://mtg-portal-backend:8080;
        proxy_set_header Host $host;
        proxy_read_timeout 300s;
        client_max_body_size 25m;
        # Stream API responses straight through instead of buffering large JSON
        # payloads to a temp file (avoids disk-dependent truncation).
        proxy_buffering off;
    }

    location / {
        try_files $uri $uri/ =404;
        # Always revalidate HTML/JS/CSS via ETag so updated assets are never
        # served stale from the browser cache (returns 304 when unchanged).
        add_header Cache-Control "no-cache" always;

        # Replaces the <!--analytics--> placeholder in the HTML pages with
        # the tracker snippet. 30-analytics.sh generates this file too;
        # without ANALYTICS_* it stays empty, so there is no sub_filter and
        # the pages keep their ETag.
        include /etc/nginx/conf.d/analytics/snippet.conf;
    }
}
