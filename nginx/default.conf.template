# Login attempts per client, on top of the backend's own throttle for wrong
# passwords. (http level: conf.d files are included inside http {}.)
limit_req_zone $binary_remote_addr zone=mtg_auth:1m rate=30r/m;

server {
    listen       80;
    server_name  _;
    root   /usr/share/nginx/html;
    index  index.html;

    # No nginx version in headers and error pages.
    server_tokens off;

    # The real client address: Traefik (or another proxy in a private
    # network) puts it into X-Forwarded-For. Only addresses from private
    # ranges are trusted to set it, so a client on the internet cannot pick
    # its own.
    set_real_ip_from 10.0.0.0/8;
    set_real_ip_from 172.16.0.0/12;
    set_real_ip_from 192.168.0.0/16;
    set_real_ip_from 127.0.0.1;
    real_ip_header X-Forwarded-For;
    real_ip_recursive on;

    include /etc/nginx/snippets/security-headers.conf;

    # Collection/card JSON payloads run into several MB uncompressed for large
    # collections; gzip cuts that drastically for both the API and static assets.
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_comp_level 5;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;

    # --- Local image mirror with a fallback to Scryfall ---
    # The volume sits at <root>/img. try_files decides per file: if it is
    # mirrored it comes from here, otherwise the browser is redirected to
    # Scryfall. That is why the browser needs no existence check per card -
    # that would be an extra request per image and cost more than the mirror
    # saves.
    #
    # A redirect, not a proxy: proxied, anybody could fetch any Scryfall image
    # through this server, on its bandwidth. Redirected, the browser loads it
    # from Scryfall itself, without our cookies (another domain).
    #
    # With the mirror off (IMAGE_MIRROR), the frontend builds Scryfall URLs
    # directly and these blocks are never requested.
    location /img/cards/ {
        try_files $uri @scryfall_cards;
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "public, max-age=2592000" always;
    }
    location @scryfall_cards {
        include /etc/nginx/snippets/security-headers.conf;
        # Short, so an image mirrored later is soon taken from here.
        add_header Cache-Control "public, max-age=86400" always;
        rewrite ^/img/cards/(.*)$ https://cards.scryfall.io/$1 redirect;
    }

    location /img/sets/ {
        try_files $uri @scryfall_svg;
        expires 30d;
    }
    location /img/symbols/ {
        try_files $uri @scryfall_symbols;
        expires 30d;
    }
    location @scryfall_svg {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "public, max-age=86400" always;
        rewrite ^/img/sets/(.*)$ https://svgs.scryfall.io/sets/$1 redirect;
    }
    location @scryfall_symbols {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "public, max-age=86400" always;
        rewrite ^/img/symbols/(.*)$ https://svgs.scryfall.io/card-symbols/$1 redirect;
    }

    # --- Analytics (optional) ---
    # The two proxy paths are generated at startup from the ANALYTICS_*
    # variables by /docker-entrypoint.d/30-analytics.sh. With nothing set the
    # file is empty and nothing is proxied (see nginx/analytics.sh and the
    # README).
    include /etc/nginx/conf.d/analytics/locations.conf;

    # API requests are proxied to the Go backend container.
    # The Android app (download/magic-portal.apk), put there by the Android
    # pipeline on every push to main - a bind mount, not part of the image.
    # Revalidated every time, so a new build is picked up at once.
    location /download/ {
        # nginx's mime.types does not know .apk; Android installs it more
        # readily with the proper type. (types{} here replaces the global map.)
        types {
            application/vnd.android.package-archive apk;
            application/json json;
        }
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache";
        try_files $uri =404;
    }

    location /api/ {
        include /etc/nginx/snippets/api-proxy.conf;
    }
    location = /api/login {
        limit_req zone=mtg_auth burst=10 nodelay;
        limit_req_status 429;
        include /etc/nginx/snippets/api-proxy.conf;
    }
    location = /api/auth-check {
        limit_req zone=mtg_auth burst=30 nodelay;
        limit_req_status 429;
        include /etc/nginx/snippets/api-proxy.conf;
    }

    location / {
        try_files $uri $uri/ =404;
        # Always revalidate HTML/JS/CSS via ETag so updated assets are never
        # served stale from the browser cache (returns 304 when unchanged).
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache" always;

        # Replaces the <!--analytics--> placeholder in the HTML pages with
        # the tracker snippet. 30-analytics.sh generates this file too;
        # without ANALYTICS_* it stays empty, so there is no sub_filter and
        # the pages keep their ETag.
        include /etc/nginx/conf.d/analytics/snippet.conf;
    }
}
