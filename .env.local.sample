# Environment for the local test instance (docker-compose.local.yml).
# Make a copy:  cp .env.local.sample .env.local
# .env.local is excluded via .gitignore and may contain credentials.
#
# Note: SERVICE/HOST/PORT from the server .env are not needed here - container
# names and the port (127.0.0.1:8088) are fixed in the compose file.

# Password for upload/reset/sync in the local interface.
UPLOAD_PASSWORD=local

# Background sync against Scryfall (minutes, default 5).
#SYNC_INTERVAL_MINUTES=60

# --- Automatic remote import ---
# Off by default. To test it, set WEBDAV_URL - deleting the source file is
# hard-wired to false in docker-compose.local.yml, so the file stays put for
# the server. Still better to use a test file of your own rather than the real
# ManaBox location, otherwise the server imports it in parallel.
#REMOTE_IMPORT_INTERVAL_MINUTES=15
#WEBDAV_URL=https://cloud.example.com/remote.php/dav/files/USER/test/export.csv
#WEBDAV_USER=myuser
#WEBDAV_PASSWORD=app-password

# --- Backup ---
# Deliberately without a target: the upload targets are set to empty in
# docker-compose.local.yml and cannot be enabled from here.

# --- Analytics ---
# Off by default. To try it out, set the same ANALYTICS_* variables as in
# .env.sample; locally this only makes sense against a test instance.
#ANALYTICS_SCRIPT_URL=https://stats.example.com/script.js
#ANALYTICS_EVENT_URL=https://stats.example.com/api/send
#ANALYTICS_WEBSITE_ID=00000000-0000-0000-0000-000000000000
