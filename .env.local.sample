# Umgebung für die lokale Test-Instanz (docker-compose.local.yml).
# Kopie anlegen:  cp .env.local.sample .env.local
# .env.local ist per .gitignore ausgeschlossen und darf Zugangsdaten enthalten.
#
# Hinweis: SERVICE/HOST/PORT aus der Server-.env werden hier nicht gebraucht –
# Containernamen und der Port (127.0.0.1:8088) stehen fest in der Compose-Datei.

# Passwort für Upload/Reset/Sync in der lokalen Oberfläche.
UPLOAD_PASSWORD=local

# Hintergrund-Sync gegen Scryfall (Minuten, Standard 5).
#SYNC_INTERVAL_MINUTES=60

# --- Automatischer Remote-Import ---
# Standard: aus. Zum Testen WEBDAV_URL setzen – das Löschen der Quelldatei ist
# in docker-compose.local.yml fest auf false gestellt, die Datei bleibt für den
# Server also liegen. Besser trotzdem eine eigene Testdatei statt der echten
# ManaBox-Ablage verwenden, sonst importiert der Server sie parallel.
#REMOTE_IMPORT_INTERVAL_MINUTES=15
#WEBDAV_URL=https://cloud.example.com/remote.php/dav/files/USER/test/export.csv
#WEBDAV_USER=meinuser
#WEBDAV_PASSWORD=app-passwort

# --- Backup ---
# Bewusst ohne Ziel: Upload-Ziele sind in docker-compose.local.yml leer gesetzt
# und lassen sich von hier aus nicht aktivieren.
